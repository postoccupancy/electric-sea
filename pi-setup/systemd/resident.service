[Unit]
Description=Resident Frequency Persistent-Spectrum Analysis
After=network.target router.service
Requires=router.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/electric-sea/router
ExecStart=/usr/bin/node resident-live-controls.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
